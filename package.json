{
  "name": "fetchquack",
  "version": "1.0.1",
  "description": "A lightweight HTTP client with support for streaming, SSE, progress monitoring and interceptors. Works in the browser, Node.js, Bun and Deno. Includes an Angular wrapper.",
  "license": "MIT",
  "author": "Adrián Bueno Jiménez (devadri.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrian-bueno/fetchquack"
  },
  "private": true,
  "keywords": [
    "http",
    "fetch",
    "sse",
    "streaming",
    "stream",
    "server-sent-events",
    "event-source",
    "angular",
    "node",
    "bun",
    "deno",
    "duck",
    "quack",
    "client",
    "typescript"
  ],
  "scripts": {
    "build": "bun scripts/build.mts",
    "link": "cd dist && bun link && npm link",
    "pack": "cd dist && npm pack",
    "mock-server": "bun test/mock-server/server.ts --port 3000 --static",
    "test": "bun test/run-tests.ts",
    "test:node": "bun test/run-tests.ts node",
    "test:deno": "bun test/run-tests.ts deno",
    "test:bun": "bun test/run-tests.ts bun",
    "test:browser": "bun test/run-tests.ts browser"
  },
  "type": "module",
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "19.2.18",
    "@angular/compiler": "19.2.18",
    "@angular/compiler-cli": "19.2.18",
    "@angular/core": "19.2.18",
    "@types/bun": "1.3.6",
    "@types/node": "22.10.5",
    "bunup": "0.16.20",
    "esbuild": "0.27.2",
    "ng-packagr": "19.2.2",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "zone.js": "0.15.0"
  }
}
